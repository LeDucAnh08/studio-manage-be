# MongoDB Connection String
MONGO_URI=mongodb://admin:secret@localhost:27017/studio_db?authSource=admin

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Server
PORT=5001
NODE_ENV=development

# Package demo images. Default: <repository root>/.data/package-media (outside src/dist).
# Use an absolute persistent directory when deploying or backing up the application.
# UPLOAD_DIR=
# Private edited photos: persistent directory outside public/static roots.
# PRIVATE_DELIVERY_DIR=

# Feature flags
CLIENT_PORTAL_ENABLED=true
CLIENT_WORKFLOW_ENABLED=false

# Client workflow payment details displayed on accepted quotes
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_TRANSFER_TEMPLATE=YUME {bookingId}

# Automatic package deposits. Off until bank + authenticated webhook are configured.
# `node ops/sepay-sandbox.cjs serve` uses the saved test account + webhook secret
# even when SEPAY_ENABLED=false for the main application.
# Keep SEPAY_MODE=sandbox for SePay Test mode; the demo runner uses its isolated DB.
SEPAY_ENABLED=false
SEPAY_TEST_ON_MAIN_DB=false
# Explicit opt-in: true allows provider Test mode on loopback studio_db in development.
# Internal simulated payments remain disabled on studio_db.
SEPAY_DEMO_UI=false
SEPAY_MODE=sandbox
# The sandbox runner selects this isolated DB. Regular startup honors MONGO_URI.
# Use EMAIL_MODE=test with this sandbox (or disable email).
SEPAY_SANDBOX_DATABASE=studio_sepay_sandbox
PAYMENT_BANK_CODE=MBBank
SEPAY_BANK_GATEWAY=MBBank
SEPAY_WEBHOOK_SECRET=

# Transactional email. Test mode captures messages in an isolated local DB only.
# New automatic rentals collect a 30% advance deducted from the rental fee.
RENTAL_HOLD_MINUTES=15
RENTAL_MAX_PENDING=2
RENTAL_MIN_LEAD_HOURS=24
RENTAL_TURNAROUND_DAYS=1
RENTAL_OPEN_HOUR=9
RENTAL_CLOSE_HOUR=17
# 0=Sunday ... 6=Saturday; empty means open every day.
RENTAL_CLOSED_WEEKDAYS=

EMAIL_ENABLED=false
EMAIL_MODE=resend
EMAIL_FROM=Yume Studio <notifications@example.com>
EMAIL_PUBLIC_URL=https://your-studio.example
# Local Resend demo: NODE_ENV=development and EMAIL_PUBLIC_URL=http://localhost:4001
RESEND_API_KEY=

# CORS (production only, comma-separated for multiple origins)
# CORS_ORIGIN=https://your-frontend-domain.com

# Seed
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@1234

# Seed admin credentials
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=Admin@1234

# Telegram bot (thông báo lịch chụp)
TELEGRAM_BOT_TOKEN=

# Google Apps Script Web App — tạo folder Drive & ghi Sheet khi tạo lịch
# URL lấy sau khi Deploy Apps Script dạng Web app (Execute as me, Access: Anyone)
GAS_WEBHOOK_URL=
# Chuỗi bí mật dùng chung, phải trùng Script Property "SECRET" bên Apps Script
GAS_WEBHOOK_SECRET=

# Public-link Google Drive photo albums (Drive API v3 must be enabled).
# Server-side only. Never expose this key in VITE_* or the browser.
GOOGLE_DRIVE_API_KEY=
