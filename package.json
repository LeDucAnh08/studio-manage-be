{
  "name": "studio-management-backend",
  "version": "1.0.0",
  "description": "Studio yearbook photography management - backend",
  "license": "UNLICENSED",
  "resolutions": {
    "**/@types/express": "^4.17.21"
  },
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "start": "node dist/app.js",
    "build": "tsc",
    "check": "tsc --noEmit && prettier --check \"src/**/*.{ts,json}\"",
    "test": "node --require ./tests/environment.cjs --test tests/client-bookings.cjs tests/account-requests.cjs tests/costume-catalog.cjs tests/rental-access.cjs tests/phase1-mongo-integration.cjs tests/booking-costumes.cjs tests/customer-order-views.cjs tests/photographer-assignment.cjs tests/booking-expiry.cjs tests/package-content.cjs tests/package-booking.cjs tests/sepay-deposits.cjs tests/email-notifications.cjs tests/booking-delivery.cjs tests/booking-album.cjs tests/rental-auto-checkout.cjs tests/concept-booking.cjs tests/photographer-portfolio.cjs tests/shoot-orders.cjs tests/customer-validation.cjs tests/customer-session.cjs tests/admin-dashboard.cjs tests/class-students.cjs tests/order-thumbnails.cjs tests/retired-roles.cjs tests/telegram-removal.cjs tests/queue-config.cjs tests/roles.cjs tests/remove-seasons.cjs tests/classes.cjs tests/package-detail-store.cjs tests/shared-album-store.cjs",
    "test:contract": "node --require ./tests/environment.cjs --test tests/client-bookings.cjs tests/account-requests.cjs tests/costume-catalog.cjs tests/rental-access.cjs tests/package-content.cjs tests/customer-session.cjs tests/admin-dashboard.cjs",
    "test:integration": "node --require ./tests/environment.cjs --test tests/phase1-mongo-integration.cjs tests/booking-costumes.cjs tests/customer-order-views.cjs tests/photographer-assignment.cjs tests/booking-expiry.cjs tests/sepay-deposits.cjs tests/email-notifications.cjs tests/booking-delivery.cjs tests/booking-album.cjs tests/rental-auto-checkout.cjs",
    "test:booking-costumes": "node --require ./tests/environment.cjs --test tests/booking-costumes.cjs",
    "test:package-content": "node --require ./tests/environment.cjs --test tests/package-content.cjs",
    "test:package-booking": "node --require ./tests/environment.cjs --test tests/package-booking.cjs",
    "test:sepay": "node --require ./tests/environment.cjs --test tests/sepay-deposits.cjs",
    "sepay:maintenance": "ts-node src/utils/sepayMaintenance.ts",
    "email:outbox": "ts-node src/utils/emailOutbox.ts",
    "test:email": "node --require ./tests/environment.cjs --test tests/email-config.cjs tests/sandbox-startup.cjs tests/email-notifications.cjs",
    "test:delivery": "node --require ./tests/environment.cjs --test tests/booking-delivery.cjs",
    "delivery:cleanup": "ts-node src/utils/cleanupDeliveryPhotos.ts",
    "seed": "ts-node src/utils/seed.ts",
    "migrate:remove-telegram": "ts-node src/utils/removeTelegram.ts",
    "migrate:roles": "ts-node src/utils/migrateRoles.ts",
    "test:roles": "node --require ./tests/environment.cjs --test tests/roles.cjs tests/retired-roles.cjs tests/account-requests.cjs tests/client-bookings.cjs",
    "copy:prod-to-local": "ts-node src/utils/copyProdToLocal.ts",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "test:album": "node --require ./tests/environment.cjs --test tests/booking-album.cjs",
    "test:rental": "node --require ./tests/environment.cjs --test tests/rental-auto-checkout.cjs tests/rental-access.cjs tests/costume-catalog.cjs",
    "test:shoot-orders": "node --require ./tests/environment.cjs --test tests/shoot-orders.cjs",
    "test:portfolio": "node --require ./tests/environment.cjs --test tests/photographer-portfolio.cjs",
    "test:concept": "node --require ./tests/environment.cjs --test tests/concept-booking.cjs",
    "test:admin-dashboard": "node --require ./tests/environment.cjs --test tests/admin-dashboard.cjs",
    "test:class-students": "node --require ./tests/environment.cjs --test tests/class-students.cjs",
    "worker": "node dist/workers/main.js",
    "worker:dev": "ts-node --transpile-only src/workers/main.ts",
    "test:jobs": "node --require ./tests/environment.cjs --test tests/queue-config.cjs tests/background-jobs.cjs",
    "test:queue-config": "node --require ./tests/environment.cjs --test tests/queue-config.cjs",
    "migrate:remove-seasons": "ts-node src/utils/removeSeasons.ts",
    "test:remove-seasons": "node --require ./tests/environment.cjs --test tests/remove-seasons.cjs tests/photographer-dashboard.cjs tests/admin-dashboard.cjs tests/class-students.cjs",
    "migrate:classes": "ts-node src/utils/renameClasses.ts",
    "test:classes": "node --require ./tests/environment.cjs --test tests/classes.cjs tests/class-students.cjs tests/customer-session.cjs tests/customer-validation.cjs",
    "migrate:package-details": "ts-node src/utils/migratePackageDetails.ts",
    "migrate:albums": "ts-node src/utils/migrateAlbums.ts",
    "test:album-store": "node --require ./tests/environment.cjs --test tests/shared-album-store.cjs",
    "test:package-details": "node --require ./tests/environment.cjs --test tests/package-content.cjs tests/package-detail-store.cjs tests/order-thumbnails.cjs"
  },
  "dependencies": {
    "archiver": "5.3.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "5.81.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb-connection-string-url": "^3.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.18.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.17.5",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
